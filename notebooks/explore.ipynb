   "source": [
    "# Binning\n",
    "import numpy as np\n",
    "x = np.random.random(4) # values between 0 and 1\n",
    "print (\"x:\", x)\n",
    "bins = np.linspace(0, 1, 5) # bins between 0 and 1\n",
    "print (\"bins:\", bins)\n",
    "binned = np.digitize(x, bins)\n",
    "print (\"binned:\", binned)"
   ]
  }
